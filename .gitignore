# DTM raw JSON (HDX HAPI snapshots; harmonization logs are tracked)
data/dtm/**/*_raw.json
# Colombia RUV cross-section snapshot from datos.gov.co (regeneratable)
data/dtm/colombia_ruv/*.json
data/dtm/colombia_ruv/_socrata_catalog_search.json

# Historical-polygon source PDFs (copyrighted; re-fetchable via build scripts)
historical_polygons/_sources/*.pdf
historical_polygons/_sources/*.txt
historical_polygons/_sources/*.png
historical_polygons/_sources/*.jpg

# Historical polygon digitization outputs (committed when ready;
# provenance.md tracked separately)
historical_polygons/**/*.geojson
historical_polygons/**/*.shp
historical_polygons/**/*.gpkg
historical_polygons/**/*.png
!historical_polygons/**/provenance.md

